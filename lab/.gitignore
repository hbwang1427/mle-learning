# DVC-managed sample data -- generate it locally with
# `python data/generate_synthetic_depth.py`, then `dvc add` it (see
# DVC_PRACTICE.md). Never commit raw data straight to git.
data/synthetic_depth/

# DVC internal config/cache -- each student runs `dvc init` themselves.
.dvc/
.dvcignore

# DVC pipeline lock file -- generated by your own `dvc repro` run.
# In a real team project this WOULD normally be committed; we leave it out
# here so the practice exercise produces your own fresh lock file.
dvc.lock

# Training artifacts -- produced by running the pipeline yourself.
outputs/*.pt
outputs/*.npy
outputs/*.png
*.png
*.gif
